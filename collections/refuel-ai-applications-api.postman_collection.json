          "name": "Transform rows with a deployed application",
          "request": {
            "name": "Transform rows with a deployed application",
            "description": {
              "content": "Submit a JSON array of input rows to a deployed application to run LLM labeling / prediction in realtime. Each row is an object whose keys match the application's expected input fields. The application applies its Task guidelines and returns the transformed (labeled / enriched) output for each row. Subject to a documented rate limit of 300 requests per minute and up to 100 concurrent requests.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "applications",
                ":applicationName",
                "label"
